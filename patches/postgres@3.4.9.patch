diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..555b67bb8b5f5e82698e53751c57579a1b951397 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -172,11 +172,18 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         : (query = q, query.active = true)
 
       build(q)
-      return write(toBuffer(q))
+      const written = write(toBuffer(q))
+      // sql.begin and sql.reserve claim the connection in onexecute. Call it
+      // unconditionally: otherwise a full pipeline, or max_pipeline: 0, skips
+      // the claim and the transaction fails with UNSAFE_TRANSACTION.
+      if (q.options.onexecute) {
+        q.options.onexecute(connection)
+        return false
+      }
+      return written
         && !q.describeFirst
         && !q.cursorFn
         && sent.length < max_pipeline
-        && (!q.options.onexecute || q.options.onexecute(connection))
     } catch (error) {
       sent.length === 0 && write(Sync)
       errored(error)
