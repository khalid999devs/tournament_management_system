DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres?sslmode=require
# Optional on Vercel: the *.vercel.app address is used automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Staff invitations and the live-update signal use it.
SUPABASE_SECRET_KEY=
SUPER_ADMIN_EMAIL=admin@example.com

# Email through Gmail SMTP (no domain needed). Use a Google App Password.
SMTP_USER=ndcakofficial@gmail.com
SMTP_PASSWORD=
EMAIL_FROM_NAME="NDCAK Indoor Games"
EMAIL_REPLY_TO=ndcakofficial@gmail.com

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protects /api/cron/daily (reminders, email retries, keep-alive). Vercel
# sends it automatically to the cron in vercel.json. 16+ random characters.
CRON_SECRET=
